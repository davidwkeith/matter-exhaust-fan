# GN root for exhaustd-matter: the Raspberry Pi controller with Matter,
# built out of tree against connectedhomeip (third_party/connectedhomeip).
import("//build_overrides/build.gni")

buildconfig = "${build_root}/config/BUILDCONFIG.gn"

# CHIP uses angle bracket includes.
check_system_includes = true

default_args = {
  import("//args.gni")
}
