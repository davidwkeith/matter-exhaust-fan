# Matter Exhaust Fan + Light Controller — build defaults
#
# Matter transport is Thread; Wi-Fi runs alongside it for the local
# mDNS/HTTP maintenance UI (spec §5.4). The stock esp-matter light example
# defaults to Wi-Fi even on Thread-capable hardware, so Thread is selected
# explicitly here (spec §6.1).

CONFIG_IDF_TARGET="esp32c6"

# --- Thread (Matter transport) ---
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_ENABLE_MATTER_OVER_THREAD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y

# --- Wi-Fi (maintenance UI only — mDNS + HTTP, never Matter) ---
CONFIG_ENABLE_WIFI_STATION=y

# --- BLE for Matter commissioning ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- Size: the binary must fit the 1.92MB OTA slots (dual-OTA on 4MB) ---
# Also switches the CHIP static library from O3 to Os.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y
# BLE is only ever a commissioning advertiser — drop the unused roles.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# --- Crypto / runtime requirements from the esp-matter examples ---
# CHIP's mbedTLS crypto PAL links against mbedtls_hkdf; the HKDF module is
# off by default in ESP-IDF.
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# --- Flash / storage ---
# XIAO ESP32-C6 (reference board) carries 4MB flash; the partition layout
# (dual ~1.9MB OTA slots + fctry) requires it.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_NVS_ENCRYPTION=n

# --- mDNS ---
CONFIG_MDNS_MAX_SERVICES=10
